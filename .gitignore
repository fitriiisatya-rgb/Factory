# PHP staging skeleton — never commit real credentials or local env state
api/app/config/config.php
api/_setup/.disabled
api/.env
api/.env.local
api/vendor/
api/composer.lock

# Local disposable validation artifacts (Phase 0 test runs)
api/tests/.tmp/
*.sqlite
*.sqlite3

# dist/amor-factory-api-preprod.zip IS committed deliberately (contains no
# secrets — verified by build-cpanel-package.sh's own sanity check — and a
# non-technical operator needs to download it directly, not run a build
# script). Only the transient staging directory is ignored.
dist/.stage/
