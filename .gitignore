# PHP staging skeleton — never commit real credentials or local env state
api/app/config/config.php
api/_setup/.disabled
api/.env
api/.env.local
api/vendor/
api/composer.lock

# Local disposable validation artifacts (Phase 0 test runs)
api/tests/.tmp/
*.sqlite
*.sqlite3

# Self-referential symlink some php -S test orchestrators create for the
# duration of their own run (see run-production-division-fg-rework.sh's
# own docblock at its "ln -sfn . "$API_ROOT/api"" step) so a disposable
# local server can resolve "/api/assets/..." the same way real cPanel's
# one-level-higher docroot does. Removed by each script's own cleanup()
# trap on exit — this entry only guards against a run that is still in
# progress (or was killed) when git status is checked.
api/api

# Runtime-uploaded receipt evidence photos (Phase 5.5 Driver/Bakery
# receipt UAT flows write real files here against the live api/ tree,
# same as a real deployment's writable uploads dir would) — only the
# .htaccess protecting this directory is source-controlled, never the
# uploaded content itself.
api/uploads/receipt-evidence/*
!api/uploads/receipt-evidence/.htaccess

# Permanent Bakery Portal (migration 0017) — Pesanan Khusus/Custom
# reference photos, same "only the .htaccess is source-controlled" rule.
api/uploads/special-order-attachment/*
!api/uploads/special-order-attachment/.htaccess

# Permanent Bakery Portal (migration 0017) — Retur evidence photos, same rule.
api/uploads/retur-evidence/*
!api/uploads/retur-evidence/.htaccess

# Permanent Bakery Portal (migration 0017) — Mutasi evidence photos, same rule.
api/uploads/mutasi-evidence/*
!api/uploads/mutasi-evidence/.htaccess

# dist/amor-factory-api-preprod.zip IS committed deliberately (contains no
# secrets — verified by build-cpanel-package.sh's own sanity check — and a
# non-technical operator needs to download it directly, not run a build
# script). Only the transient staging directory is ignored.
dist/.stage/
